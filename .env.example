# Copy this file to .env.local and fill in the values.

# MongoDB Atlas connection string (Atlas → your cluster → Connect → Drivers).
# Works with a normal replica-set cluster or an Atlas Global Cluster.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name (optional)
MONGODB_DB="chicken_wholesale_books"

# Optional: "nearest" lets a multi-region / global cluster serve reads from the closest region.
# Leave empty for "primary" (always the newest data).
MONGODB_READ_PREFERENCE=""

# Secret used to sign login sessions: a random string of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
